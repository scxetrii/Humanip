# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME="Humanip"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-very-secret-key-change-this-in-production

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/humanizer.db

# ─── LLM Provider (choose one or configure multiple) ─────────────────────────
# Options: openai | anthropic | google | ollama | custom
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-1.5-pro

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Custom OpenAI-compatible endpoint (e.g. LM Studio, OpenRouter)
CUSTOM_LLM_BASE_URL=http://localhost:1234/v1
CUSTOM_LLM_API_KEY=lm-studio
CUSTOM_LLM_MODEL=local-model

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".txt",".docx",".pdf"]
UPLOAD_DIR=./data/uploads

# ─── NLP Models ───────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
# Options: en_core_web_sm | en_core_web_md | en_core_web_lg | en_core_web_trf

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_LOCAL_MODELS=false
ENABLE_GRAMMAR_CHECK=true
ENABLE_HISTORY=true
LOG_LEVEL=INFO
