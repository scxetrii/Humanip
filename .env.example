# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME=Humanip
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-very-secret-key-change-this-in-production

# ─── Server ───────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# ─── LLM Provider (choose one) ────────────────────────────────────────────────
# Options: openai | anthropic | cohere | ollama
LLM_PROVIDER=openai

# OpenAI (also works with any OpenAI-compatible endpoint via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── LLM Timeouts & Retries ───────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60            # seconds per API attempt
LLM_MAX_RETRIES=2         # total attempts before giving up
LLM_TOTAL_TIMEOUT=90      # hard cap for a single LLM call
HUMANIZE_TIMEOUT=110      # overall LLM budget for one humanization request

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
ALLOWED_EXTENSIONS=[".txt",".docx",".pdf"]

# ─── NLP Models ───────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
# Options: en_core_web_sm | en_core_web_md | en_core_web_lg | en_core_web_trf
ENABLE_LOCAL_TRANSFORMERS=false
ENABLE_GRAMMAR_CHECK=false

# ─── History ──────────────────────────────────────────────────────────────────
HISTORY_MAX_ITEMS=500
HISTORY_RETENTION_DAYS=30

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
